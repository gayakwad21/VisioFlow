# VisionForge Platform Environment Configuration

# Django Settings
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL 8.0 database configuration
DB_NAME=visionforge_db
DB_USER=visionforge
DB_PASSWORD=replace-with-your-local-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Computer Vision FastAPI Microservice URL
CV_SERVICE_URL=http://127.0.0.1:8001
CV_SERVICE_TIMEOUT=600

# AI LLM Integration (Optional - intelligent rule-based fallback used if omitted)
LLM_API_KEY=
